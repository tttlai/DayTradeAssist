# --- Angel One SmartAPI credentials (read-only usage: quotes & candles only) ---
# Register free at https://smartapi.angelbroking.com -> create an app -> get API key
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# The PIN you use to log into Angel One (NOT your trading password)
ANGEL_PIN=
# TOTP secret shown when you enable external TOTP for SmartAPI (base32 string)
ANGEL_TOTP_SECRET=

# --- Telegram notification ---
# Message @BotFather on Telegram to create a bot and get this token
TELEGRAM_BOT_TOKEN=
# Message @userinfobot (or check getUpdates) to get your numeric chat id
TELEGRAM_CHAT_ID=

# --- Risk / budget settings (all optional, sensible defaults in config.py) ---
# Total capital you're willing to deploy across all picks today
MAX_BUDGET=50000
# Fraction of MAX_BUDGET you're willing to risk on a single trade if its stop-loss is hit
RISK_PER_TRADE_PCT=0.01
# Max number of stock picks per day
MAX_PICKS=3
# Mandatory intraday square-off time (MIS positions must close by this time)
SQUARE_OFF_TIME=15:15
# Require price to be on the expected side of VWAP (above for a LONG, below
# for a SHORT) before confirming a trigger. Can't be backtested against this
# project's free NSE data, so validated by watching live results. Set to
# "false" to disable if it doesn't end up helping.
REQUIRE_VWAP_CONFIRMATION=true

# --- Daily eval agent (optional) ---
# Leave blank to skip this phase entirely (no error, same as Telegram being
# unconfigured elsewhere). Get a key at https://console.anthropic.com --
# this is a SEPARATE product from claude.ai/Claude Code, billed per API call.
# Unlike everything else in this project, this is a real small recurring
# cost: one LLM call/day, likely a fraction of a cent to a few cents.
ANTHROPIC_API_KEY=
# Which model to use for the daily eval. Defaults to Sonnet 5 for quality;
# switch to a cheaper/faster model if you want to cut the per-day cost.
EVAL_MODEL=claude-sonnet-5
