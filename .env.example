# --- Angel One SmartAPI credentials (read-only usage: quotes & candles only) ---
# Register free at https://smartapi.angelbroking.com -> create an app -> get API key
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# The PIN you use to log into Angel One (NOT your trading password)
ANGEL_PIN=
# TOTP secret shown when you enable external TOTP for SmartAPI (base32 string)
ANGEL_TOTP_SECRET=

# --- Telegram notification ---
# Message @BotFather on Telegram to create a bot and get this token
TELEGRAM_BOT_TOKEN=
# Message @userinfobot (or check getUpdates) to get your numeric chat id
TELEGRAM_CHAT_ID=

# --- Risk / budget settings (all optional, sensible defaults in config.py) ---
# Total capital you're willing to deploy across all picks today
MAX_BUDGET=50000
# Fraction of MAX_BUDGET you're willing to risk on a single trade if its stop-loss is hit
RISK_PER_TRADE_PCT=0.01
# Max number of stock picks per day
MAX_PICKS=3
# Mandatory intraday square-off time (MIS positions must close by this time)
SQUARE_OFF_TIME=15:15
# Require price to be on the expected side of VWAP (above for a LONG, below
# for a SHORT) before confirming a trigger. Can't be backtested against this
# project's free NSE data, so validated by watching live results. Set to
# "false" to disable if it doesn't end up helping.
REQUIRE_VWAP_CONFIRMATION=true
# Where history and trade logs are kept so they survive redeploys. On Railway
# just attach a Volume at /app/data/store -- RAILWAY_VOLUME_MOUNT_PATH is set
# automatically and used. Only set PERSIST_DIR to override (default: data/).
# PERSIST_DIR=

# Stream live ticks over Angel's WebSocket (src/stream.py) instead of polling
# REST; falls back to REST automatically whenever the stream is down.
STREAM_ENABLED=true

# At most this many watchlist picks per sector (sectors come from
# data/universe.csv). 0 disables. Backtest: 2 neutral, 1 worse.
MAX_PER_SECTOR=2

# --- Opening-gap fade alerts for cheap, liquid stocks (src/penny.py) --------------
# Each morning the live stream reads every stock's opening gap right after 09:15:
# a gap UP of PENNY_GAP_MIN+ is a SHORT alert, a gap DOWN a BUY alert, with a
# percentage target and stop. Set PENNY_ENABLED=false to turn the feature off.
PENNY_ENABLED=true
# PENNY_PRICE_MIN=10
# PENNY_PRICE_MAX=100
# PENNY_MIN_DAILY_VALUE=30000000   (Rs 3 crore traded per day, 20-day average)
# PENNY_GAP_MIN=0.02
# PENNY_GAP_MAX=0.05
# PENNY_TARGET_PCT=0.03
# PENNY_STOP_PCT=0.02
# PENNY_MAX_ALERTS=3               (per day)
# PENNY_ALLOW_SHORTS=true          (false = BUY alerts only)
# PENNY_PREOPEN=true               (09:10 heads-up from indicative pre-open prices, if the feed has them)
# PENNY_BUDGET=                    (defaults to MAX_BUDGET, split across the max alerts)

# Skip an entry once price is already more than this many ATRs past the
# trigger (a late chase). 0 disables. See README / config.py for the backtest.
MAX_CHASE_ATR=0.5
# Stock universe: "csv" (default; the ~50 large caps in data/universe.csv) or
# "liquid" (every NSE EQ stock passing the two floors below). Backtested with
# realistic fills, "liquid" did WORSE over 120 days (about Rs -17.9k vs -3.8k),
# so it is opt-in only -- leave on csv unless you want to experiment.
UNIVERSE_MODE=csv
UNIVERSE_MIN_DAILY_VALUE=50000000
UNIVERSE_MIN_PRICE=20

# --- Daily eval agent (optional) ---
# Leave blank to skip this phase entirely (no error, same as Telegram being
# unconfigured elsewhere). Get a key at https://console.anthropic.com --
# this is a SEPARATE product from claude.ai/Claude Code, billed per API call.
# Unlike everything else in this project, this is a real small recurring
# cost: one LLM call/day, likely a fraction of a cent to a few cents.
ANTHROPIC_API_KEY=
# Which model to use for the daily eval. Defaults to Sonnet 5 for quality;
# switch to a cheaper/faster model if you want to cut the per-day cost.
EVAL_MODEL=claude-sonnet-5

# --- Eval agent auto-tuning via GitHub PR (optional, needs ANTHROPIC_API_KEY above) ---
# Leave GITHUB_TOKEN blank to skip this -- the eval still gives its prose
# analysis, it just never proposes a parameter change. When set, the eval
# agent can open a PR tweaking ONE whitelisted numeric constant (see
# github_pr.TUNABLE_PARAMS); you approve or reject it by replying YES or NO
# to the Telegram message that names it. Use a FINE-GRAINED PAT
# (https://github.com/settings/personal-access-tokens) scoped to ONLY this
# one repository, with Contents (read/write) and Pull requests (read/write)
# permissions -- nothing else.
GITHUB_TOKEN=
# "owner/repo", e.g. tttlai/DayTradeAssist
GITHUB_REPO=
GITHUB_BASE_BRANCH=master
